# ============ ПРОВЕРКА TG ============
def check_telegram(username):
    """
    exists=True  → ЗАНЯТ
    exists=False → СВОБОДЕН
    exists=None  → ошибка сети
    """
    username = username.lstrip("@").strip().lower()
    url = f"https://t.me/{username}"

    try:
        r = requests.get(url, headers=HEADERS, timeout=15, allow_redirects=True)
        if r.status_code == 404:
            return {"exists": False}

        soup = BeautifulSoup(r.text, "html.parser")

        title_block = soup.find("div", class_="tgme_page_title")
        if title_block and title_block.get_text(strip=True):
            return {"exists": True, "name": title_block.get_text(strip=True)}

        title_meta = soup.find("meta", property="og:title")
        desc_meta = soup.find("meta", property="og:description")
        title = title_meta["content"].strip() if title_meta and title_meta.get("content") else ""
        desc = desc_meta["content"].strip() if desc_meta and desc_meta.get("content") else ""
        low_desc = desc.lower()

        if ("if you have telegram" in low_desc
                or "you can contact" in low_desc
                or "preview channel" in low_desc
                or not desc):
            return {"exists": False}

        if title and title.lower() not in ("telegram", "telegram: contact"):
            return {"exists": True, "name": title}

        return {"exists": False}

    except Exception:
        return {"exists": None}


# ============ ПРОВЕРКА FRAGMENT ============
def check_fragment(username):
    """
    exists=True + on_sale=True  → продаётся
    exists=True + on_sale=False → есть на Fragment (занят/taken)
    exists=False                → не выставлен
    """
    username = username.lstrip("@").strip().lower()
    url = f"https://fragment.com/username/{username}"
    try:
        r = requests.get(url, headers=HEADERS, timeout=15, allow_redirects=True)

        if r.status_code == 404:
            return {"exists": False, "on_sale": False, "taken": False,
                    "price_ton": None, "price_usd": None, "url": url}
        if r.status_code != 200:
            return {"exists": False, "on_sale": False, "taken": False,
                    "price_ton": None, "price_usd": None, "url": url}
        if "/username/" not in r.url:
            return {"exists": False, "on_sale": False, "taken": False,
                    "price_ton": None, "price_usd": None, "url": url}

        soup = BeautifulSoup(r.text, "html.parser")
        text_all = soup.get_text(" ", strip=True)
        text_low = text_all.lower()

        price_ton = None
        price_usd = None

        for el in soup.find_all(class_=re.compile(r"tm-value", re.I)):
            txt = el.get_text(" ", strip=True)
            m = re.search(r"([\d][\d\s.,]*)\s*TON", txt)
            if m:
                try:
                    price_ton = float(m.group(1).replace(" ", "").replace(",", "."))
                    break
                except ValueError:
                    pass
            m2 = re.search(r"^([\d][\d\s.,]*)$", txt)
            if m2:
                try:
                    price_ton = float(m2.group(1).replace(" ", "").replace(",", "."))
                    break
                except ValueError:
                    pass

        if price_ton is None:
            m = re.search(r"([\d]{1,3}(?:[\s.,]\d{3})*(?:[.,]\d+)?)\s*TON", text_all)
            if m:
                try:
                    price_ton = float(m.group(1).replace(" ", "").replace(",", "."))
                except ValueError:
                    pass

        mu = re.search(r"\$\s*([\d.,]+)", text_all)
        if mu:
            try:
                price_usd = float(mu.group(1).replace(",", ""))
            except ValueError:
                pass

        taken = ("taken" in text_low) or ("sold" in text_low)
        has_buy = any(k in text_low for k in
                      ["buy now", "place bid", "on sale", "for sale",
                       "on auction", "buy for"])

        on_sale = False
        if price_ton is not None and not taken:
            on_sale = True
        elif has_buy and not taken:
            on_sale = True

        return {"exists": True, "on_sale": on_sale, "taken": taken,
                "price_ton": price_ton, "price_usd": price_usd, "url": url}

    except Exception as e:
        return {"exists": False, "on_sale": False, "taken": False,
                "price_ton": None, "price_usd": None, "url": url, "error": str(e)}


# ============ ОБЪЕДИНЁННАЯ ПРОВЕРКА ============
def check_one(username):
    fr = check_fragment(username)
    tg = check_telegram(username)
    return {"username": username.lstrip("@").lower(), "tg": tg, "fragment": fr}


# ============ ФОРМАТ ОТЧЁТА ============
def format_report(title, results):
    lines = [f"<b>{title}</b>\n"]
    for it in results:
        u = it["username"]
        tg = it["tg"]
        fr = it["fragment"]

        if tg["exists"] is True:
            tg_line = "🟢 Занят"
        elif tg["exists"] is False:
            tg_line = "⚪️ Свободен"
        else:
            tg_line = "⚠️ Не проверить"

        if fr["on_sale"]:
            p = f"{fr['price_ton']:.2f} TON" if fr["price_ton"] else "цена ?"
            usd = f" (~${fr['price_usd']:.2f})" if fr["price_usd"] else ""
            fr_line = f"💰 <b>Продаётся</b> — {p}{usd}"
        elif fr["exists"]:
            fr_line = "❌ На Fragment (не продаётся)"
        else:
            fr_line = "➖ Не выставлен"

        lines.append(f"<b>@{u}</b>")
        lines.append(f"  • TG: {tg_line}")
        lines.append(f"  • Fragment: {fr_line}")
        lines.append(f"  • <a href=\"{fr['url']}\">Открыть</a>")
        lines.append("")
    return "\n".join(lines)


