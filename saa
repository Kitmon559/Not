    names = [x.strip().lstrip("@") for x in re.split(r"[,\s]+", raw) if x.strip()]
    send_tg = ask_yn("\nОтправить отчёт в Telegram-группу?", default=True)

    print()
    results = []
    for u in names:
        r = check_one(u)
        tg = r["tg"]
        fr = r["fragment"]

        tg_s = ("ЗАНЯТ" if tg["exists"] is True
                else "СВОБОДЕН" if tg["exists"] is False
                else "?")

        if fr["on_sale"]:
            fr_s = f"продаётся ({fr['price_ton']} TON)" if fr["price_ton"] else "продаётся"
        elif fr["exists"]:
            fr_s = "на Fragment (не продаётся)"
        else:
            fr_s = "не выставлен"

        print(f"  @{u:<24} TG: {tg_s:<10} Fragment: {fr_s}")
        results.append(r)

    if send_tg:
        if send_to_telegram(format_report("🔎 Проверка username", results)):
            print("\n[TG] Отчёт отправлен ✅")

    pause()


# ============ РЕЖИМ 2: ГЕНЕРАТОР ============
def mode_generator():
    clear()
    print("=" * 50)
    print("       🎯 ГЕНЕРАТОР СВОБОДНЫХ USERNAME")
    print("=" * 50)

    while True:
        prefix = ask("\nНачало username (латиница/цифры, например 'if'): ").strip().lower()
        if prefix and re.fullmatch(r"[a-z0-9]+", prefix):
            break
        print("Только a-z и 0-9, минимум 1 символ.")

    min_len = max(5, len(prefix) + 1)
    while True:
        try:
            length = int(ask(f"Общая длина (от {min_len} до 32): "))
            if min_len <= length <= 32:
                break
        except ValueError:
            pass
        print(f"Введи число от {min_len} до 32.")

    print("\nЧто использовать после префикса:")
    print("  1 — только буквы (a-z)")
    print("  2 — только цифры (0-9)")
    print("  3 — буквы + цифры")
    while True:
        mode = ask("Выбери (1/2/3, по умолч. 3): ", "3").strip()
        if mode in ("1", "2", "3"):
            break
        print("Введи 1, 2 или 3.")

    if mode == "1":
        ab = string.ascii_lowercase
        mode_name = "буквы"
    elif mode == "2":
        ab = string.digits
        mode_name = "цифры"
    else:
        ab = string.ascii_lowercase + string.digits
        mode_name = "буквы + цифры"

    while True:
        try:
            want = int(ask("\nСколько свободных найти (Enter = 5): ", "5"))
            if want > 0:
                break
        except ValueError:
            pass

    check_tg_flag = ask_yn("Проверять занятость в TG?", default=True)
    send_tg = ask_yn("Отправлять каждый найденный в Telegram?", default=True)

    suffix_len = length - len(prefix)

    clear()
    print("=" * 50)
    print(f"  Префикс:    {prefix}")
    print(f"  Длина:      {length} (суффикс {suffix_len} симв.)")
    print(f"  Символы:    {mode_name}")
    print(f"  Найти:      {want}")
    print(f"  TG check:   {'да' if check_tg_flag else 'нет'}")
    print("=" * 50)
    print()

    tried = 0
    found = 0
    seen = set()

    while found < want:
        suffix = "".join(random.choice(ab) for _ in range(suffix_len))
        cand = (prefix + suffix).lower()

        if cand in seen:
            continue
        seen.add(cand)
        tried += 1

        fr = check_fragment(cand)
        if fr["exists"]:
            if fr["on_sale"]:
                print(f"  [{tried}] @{cand} — на Fragment (продаётся)")
            else:
                print(f"  [{tried}] @{cand} — на Fragment (не продаётся)")
            continue

        if check_tg_flag:
            tg = check_telegram(cand)
            if tg["exists"] is True:
                print(f"  [{tried}] @{cand} — занят в TG")
                continue
            if tg["exists"] is None:
                print(f"  [{tried}] @{cand} — ошибка TG, пропуск")
                continue

        found += 1
        print(f"\n  ✅ [{tried}] @{cand}  —  СВОБОДЕН ({found}/{want})\n")

        if send_tg:
            msg = (
                f"🎯 <b>Найден свободный username</b> ({found}/{want})\n\n"
                f"✅ <code>@{cand}</code>\n\n"
                f"TG: ⚪️ Свободен\n"
                f"Fragment: ➖ Не выставлен\n"
                f"Попытка: {tried}"
            )
            if send_to_telegram(msg):
                print(f"  [TG] Отправлено ✅\n")
            else:
                print(f"  [TG] Ошибка ❌\n")

    print(f"\n🎉 Готово! Найдено {found} за {tried} попыток.")
    pause()


